# Prettier also skips everything .gitignore lists.

# Both lockfiles are written by their package managers, never by hand.
package-lock.json
uv.lock

# Markdown belongs to markdownlint-cli2. Two formatters over the same files
# disagree eventually.
*.md

# Benchmark history is written by `just eval-record`, never by hand, so the
# recorded bytes stay exactly what the tool wrote.
benchmarks/

# Git fixture trees are data an eval trial commits byte for byte.
evals/*/fixtures/*/trees/**
tests/fixtures/evals/git/*/trees/**
